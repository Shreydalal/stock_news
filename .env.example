# ==============================================================================
# Market Intelligence Bot - Environment Variables Configuration Template
# Copy this file to '.env' and fill in your details:
# cp .env.example .env
# ==============================================================================

# System Settings
PROJECT_NAME="Market Intelligence Bot"
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Database Connection
# Defaults to local SQLite if left blank (sqlite:///./market_intelligence.db).
# For production (Render/Railway), use your Supabase PostgreSQL pooler URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/market_intelligence

# AI Model Integration
# Get your API key from https://console.groq.com/
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# GitHub Automation (Required for committing & pushing reports)
# Generate a Personal Access Token (PAT) with 'repo' scope at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPOSITORY=yourusername/market-intelligence-bot

# Alpha Vantage (Optional)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Telegram Alerts (Optional - Bonus Feature)
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# SMTP Email Setup (Optional - Bonus Feature)
# To use Gmail, configure an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@gmail.com
SMTP_PASSWORD=abcd_efgh_ijkl_mnop
EMAIL_TO=recipient@domain.com
